# Password for /admin login (falls back to SYNC_CRON_SECRET if unset)
ADMIN_SECRET=change-me-admin-password

# Client auth cookie signing (falls back to ADMIN_SECRET / SYNC_CRON_SECRET)
AUTH_SECRET=change-me-auth-secret

# Force GitHub persistence for users.json even outside Vercel (optional)
# AUTH_USE_GITHUB=1

# SMS login (sms.ru). Without API id, codes are logged/returned in dev mode.
# SMS_RU_API_ID=
# SMS_DEV_MODE=0
# SMS_RU_FROM=

# Weekly sync cron secret
SYNC_CRON_SECRET=your-secret-key-here

# VTB_RATE_CNY=12.45

# Autohome / Carapis
# AUTOHOME_API_URL=https://api.carapis.com/v2/listings
# AUTOHOME_API_KEY=
# AUTOHOME_API_LIMIT=50

# Delivery
# DELIVERY_VLADIVOSTOK_BASE=180000
# DELIVERY_MOSCOW_TRANSPORT=350000
# DELIVERY_INSURANCE_PERCENT=0.008

# Leads
# NEXT_PUBLIC_TELEGRAM_URL=https://t.me/your_username
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/79001234567
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# LEADS_WEBHOOK_URL=

# GOOGLE_SITE_VERIFICATION=
# Durable cars catalog on Vercel (GitHub Contents API)
# Create a fine-scoped PAT with Contents: Read and write for Adeptic221/vedcompany
GITHUB_TOKEN=
GITHUB_OWNER=Adeptic221
GITHUB_REPO=vedcompany
# GITHUB_REPO=Adeptic221/vedcompany  # also accepted as owner/repo
GITHUB_BRANCH=main
