# Sekret dlya ezhenedelnoj sinhronizacii (cron)
SYNC_CRON_SECRET=your-secret-key-here

# Kurs VTB: skolko rub za 1 yuan (esli ne zadan - raschet po CB + 2.5%)
# VTB_RATE_CNY=12.45

# Autohome cherez API-posrednik (napr. Carapis)
# AUTOHOME_API_URL=https://api.carapis.com/v2/listings
# AUTOHOME_API_KEY=

# Tamozhnya tks.ru (kogda budet dostup)
# TKS_API_URL=
# TKS_API_KEY=

# Lead capture — kontakty i webhook
# NEXT_PUBLIC_TELEGRAM_URL=https://t.me/your_manager
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/79001234567
# LEADS_WEBHOOK_URL=https://hooks.example.com/leads
# Na Netlify zapis v data/leads.json ne sohranyaetsya — ispolzujte LEADS_WEBHOOK_URL
# (Formspree, Zapier, Telegram Bot API, Slack webhook i t.d.)