# Секрет для еженедельной синхронизации (cron)
SYNC_CRON_SECRET=your-secret-key-here

# Курс ВТБ: сколько руб за 1 юань (если не задан — расчёт по ЦБ + 2.5%)
# VTB_RATE_CNY=12.45

# Autohome через API-посредник (напр. Carapis)
# AUTOHOME_API_URL=https://api.carapis.com/v2/listings
# AUTOHOME_API_KEY=

# Таможня tks.ru (когда будет доступ)
# TKS_API_URL=
# TKS_API_KEY=

# --- Захват заявок (leads) ---

# Публичные ссылки на кнопки «Telegram» и «WhatsApp» на сайте
# NEXT_PUBLIC_TELEGRAM_URL=https://t.me/your_username
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/79001234567

# Telegram Bot API — отправка заявок в чат (рекомендуется для Netlify)
# 1. Создайте бота через @BotFather, получите токен
# 2. Напишите боту любое сообщение, узнайте chat_id через getUpdates
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID=123456789

# Альтернатива: вебхук (Formspree, Zapier, Slack и т.д.)
# LEADS_WEBHOOK_URL=https://hooks.example.com/leads

# На Netlify запись в data/leads.json не сохраняется — используйте Telegram или вебхук

# Google Search Console — код верификации (мета-тег google-site-verification)
# Получите в Search Console → Настройки → Подтверждение права собственности → HTML-тег
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
